# Variables que docker-compose.production.yml lee del entorno o del archivo
# indicado con --env-file. Reemplaza estos ejemplos por valores del vault.

# PostgreSQL
DB_NAME=porky_gym_db
DB_USER=usuario_postgresql
DB_PASSWORD=CAMBIAR_POR_UNA_PASSWORD_SEGURA

# Django
SECRET_KEY=CAMBIAR_POR_UNA_SECRET_KEY_DJANGO_ALEATORIA
ALLOWED_HOSTS=api.tudominio.com, tudominio.com
FRONTEND_URL=https://tudominio.com

# CORS acepta una lista de orígenes separados por comas.
CORS_ALLOWED_ORIGINS=https://tudominio.com,https://www.tudominio.com

# Opcionales: correo de recuperación mediante Brevo
# Si no se configuran, el backend no podrá enviar correos de recuperación.
# BREVO_API_KEY=CAMBIAR_POR_API_KEY_DE_BREVO
# BREVO_SENDER_EMAIL=soporte@tudominio.com

# Opcionales: por defecto Compose usa latest y publica en el puerto 80.
IMAGE_TAG=latest
HTTP_PORT=80
