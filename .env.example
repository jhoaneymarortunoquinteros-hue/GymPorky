# Variables de docker-compose.yml (desarrollo local).
# Copia este archivo como .env en la raíz del repositorio.

DEBUG=True
SECRET_KEY=pon_aqui_una_clave_django_de_desarrollo

# PostgreSQL. En Compose, DB_HOST y DB_PORT se configuran internamente como
# postgres:5432; estos valores se usan al ejecutar Django directamente.
DB_NAME=porky_gym_db
DB_USER=tu_usuario_postgresql
DB_PASSWORD=tu_contraseña_postgresql
DB_HOST=localhost
DB_PORT=5432

# Enlaces y correo de recuperación
FRONTEND_URL=http://localhost:3000
BREVO_API_KEY=pon_aqui_tu_api_key_de_brevo
BREVO_SENDER_EMAIL=tu_correo_verificado_en_brevo

# URL de API usada por el navegador en desarrollo local.
VITE_API_URL=http://127.0.0.1:8000/api
